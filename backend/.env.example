# Copy to backend/.env and fill in.

# Required: signs login tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required: PostgreSQL connection (psycopg v3 driver). The backend
# refuses to start without it. Use your own server's port; a
# postgres:// or postgresql:// URL is converted automatically.
# Create the schema with: alembic upgrade head
DATABASE_URL=postgresql+psycopg://leximind:CHANGE_ME@localhost:5432/leximind

# Optional: enables text simplification.
GROQ_API_KEY=

# Optional: extra comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=
