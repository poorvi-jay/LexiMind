# Copy to backend/.env and fill in.

# Required: signs login tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection. Leave unset to fall back to local SQLite (backend/dev.db).
DATABASE_URL=postgresql://leximind:leximind@localhost:5432/leximind

# Optional: enables text simplification.
GROQ_API_KEY=

# Optional: extra comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=
